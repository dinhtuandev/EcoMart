# ============================================================
#  .env.example — MẪU cấu hình môi trường (file này COMMIT lên git)
#
#  Cách dùng: copy thành file .env rồi chỉnh theo nhu cầu.
#  File .env thật KHÔNG được commit (đã ignore trong .gitignore).
#
#  ⚠️ Mọi giá trị dưới đây là MẶC ĐỊNH cho môi trường DEV.
#     Đổi JWT secret và password DB trước khi deploy thật!
# ============================================================

# ────────────────────────────────────────────────────────────
#  1) CHẠY LOCAL (Maven / IDE — dùng H2 in-memory, không cần Docker)
#     Được springboot3-dotenv load khi chạy ./mvnw spring-boot:run
# ────────────────────────────────────────────────────────────

# Cổng khi chạy local.
# ⚠️ LƯU Ý: khi chạy Docker, root docker-compose.yml set SERVER_PORT=8081
#    và map host 8081 → container 8081, không đọc giá trị này từ file.
SERVER_PORT=8081

# H2 in-memory mặc định cho dev
SPRING_DATASOURCE_URL=jdbc:h2:mem:ecomartdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# Muốn chạy local với PostgreSQL thật thì bỏ comment 3 dòng dưới:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecomart_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgrespassword

# Hoặc dùng database cloud Neon free (không cần cài gì):
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-xxx-pooler.<region>.aws.neon.tech/ecomart_db?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-user>
# SPRING_DATASOURCE_PASSWORD=<neon-password>

# true/false: bật/tắt tính năng Docker Compose của chính Spring Boot
# (mặc định đã tắt trong application.yml — dự án dùng docker-compose.yml ở thư mục gốc repo)
SPRING_DOCKER_COMPOSE_ENABLED=false

# ────────────────────────────────────────────────────────────
#  2) CHẠY BẰNG DOCKER (docker compose up -d --build từ thư mục gốc repo)
#     docker-compose.yml nạp toàn bộ file .env này qua env_file,
#     sau đó override SPRING_DATASOURCE_* để trỏ vào container postgres.
# ────────────────────────────────────────────────────────────

# PostgreSQL — THAM CHIẾU thôi: docker-compose.yml hardcode các giá trị này
# trong service 'postgres'. Backend container nhận credentials qua override
# SPRING_DATASOURCE_* (xem docker-compose.yml). Đổi ở cả 2 nơi nếu cần khác.
POSTGRES_DB=ecomart_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5432

# ────────────────────────────────────────────────────────────
#  3) DÙNG CHUNG (cả local lẫn Docker)
# ────────────────────────────────────────────────────────────

# JWT — ⚠️ Secret phải dài >= 32 bytes, BẮT BUỘC đổi trước khi deploy thật!
# (giá trị hiện tại chỉ là placeholder để minh họa)
APP_JWT_SECRET=change-me-32-char-min-secret-key-please
APP_JWT_EXPIRATION_MS=86400000

# CORS — origin frontend production, phân tách bởi dấu phẩy.
# Bỏ comment + điền domain Vercel thật khi deploy:
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://ecomart.vercel.app

# Gmail SMTP Configuration
# ⚠️ MAIL_PASSWORD phải là Google App Password (16 ký tự từ 2FA), KHÔNG dùng mật khẩu tài khoản.
MAIL_PASSWORD=your-16-character-app-password
MAIL_USERNAME=your-email@gmail.com

# OAuth2 / Social Login Configuration (Google & Facebook)
# Tạo app & lấy credentials tại:
#   Google:   https://console.cloud.google.com/apis/credentials
#   Facebook: https://developers.facebook.com/apps/ (Facebook Login → Settings)
# Redirect URI khai báo trong console: http://localhost:3000/oauth2/callback
clientIdGoogle=your-google-client-id.apps.googleusercontent.com
clientSecretGoogle=GOCSPX-your-google-client-secret
clientIdFacebook=your-facebook-app-id
clientSecretFacebook=your-facebook-app-secret

# ────────────────────────────────────────────────────────────
#  4) THANH TOÁN (VNPay sandbox + SePay VietQR)
#     application.yml đã có giá trị mặc định — chỉ cần điền khi muốn override.
# ────────────────────────────────────────────────────────────

# VNPay (Sandbox: https://sandbox.vnpayment.vn)
# Đăng ký merchant tại: https://sandbox.vnpayment.vn/dev/
# ⚠️ Giá trị bên dưới chỉ là VÍ DỤ minh họa, KHÔNG dùng để giao dịch thật.
#   Khi deploy production phải thay bằng TMN_CODE / HASH_SECRET do VNPay cấp.
VNPAY_TMN_CODE=example-vnpay-tmn-code
VNPAY_HASH_SECRET=example-vnpay-hash-secret-32-chars-min
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return

# SePay VietQR (tạo API key tại: https://my.sepay.vn/)
SEPAY_API_KEY=your-sepay-api-key
SEPAY_ACCOUNT_NUMBER=109876543210
SEPAY_BANK=MBBank
SEPAY_QR_TEMPLATE=https://qr.sepay.vn/img?acc={acc}&bank={bank}&amount={amount}&des={des}
